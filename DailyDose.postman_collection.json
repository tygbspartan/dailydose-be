                  "mode": "raw",
                  "raw": "{\n  \"name\": \"Pax Moly Real Snail Sheet Mask\",\n  \"shortDescription\": \"Hydrating snail extract sheet mask\",\n  \"longDescription\": \"Detailed product description here...\",\n  \"price\": 299,\n  \"originalPrice\": 399,\n  \"costPrice\": 150,\n  \"stockQuantity\": 100,\n  \"lowStockThreshold\": 10,\n  \"sku\": \"PM-SNL-001\",\n  \"brandId\": 1,\n  \"categoryId\": 3,\n  \"isActive\": true,\n  \"isFeatured\": false,\n  \"sizes\": [\"S\", \"M\", \"L\"],\n  \"shortDescription\": \"Great for dry skin\",\n  \"effectiveFor\": [\"Dry skin\", \"Dull skin\"],\n  \"features\": [\"Hydrating\", \"Brightening\"],\n  \"certifications\": [\"KFDA approved\"],\n  \"howToUse\": [\"Cleanse face\", \"Apply mask\", \"Leave 15-20 min\", \"Remove and pat\"],\n  \"ingredients\": \"Water, Snail Secretion Filtrate...\",\n  \"cautions\": [\"Avoid contact with eyes\"],\n  \"metaTitle\": \"Pax Moly Snail Mask\",\n  \"metaDescription\": \"Best snail sheet mask for hydration\",\n  \"specifications\": [\n    { \"key\": \"Skin Type\", \"value\": \"All skin types\" },\n    { \"key\": \"Country of Origin\", \"value\": \"Korea\" },\n    { \"key\": \"Volume\", \"value\": \"25ml\" }\n  ]\n}"
