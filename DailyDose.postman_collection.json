{
  "info": {
    "name": "DailyDose API",
    "_postman_id": "dailydose-api-collection",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Complete API collection for DailyDose e-commerce backend"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api", "type": "string" },
    { "key": "token", "value": "", "type": "string", "description": "Customer JWT — auto-set by Login request" },
    { "key": "adminToken", "value": "", "type": "string", "description": "Admin JWT — auto-set by Admin Login request" },
    { "key": "productId", "value": "1", "type": "string" },
    { "key": "productSlug", "value": "sample-product", "type": "string" },
    { "key": "brandId", "value": "1", "type": "string" },
    { "key": "brandSlug", "value": "sample-brand", "type": "string" },
    { "key": "categoryId", "value": "1", "type": "string" },
    { "key": "categorySlug", "value": "sample-category", "type": "string" },
    { "key": "cartItemId", "value": "1", "type": "string" },
    { "key": "wishlistItemId", "value": "1", "type": "string" },
    { "key": "orderNumber", "value": "ORD-2026-001", "type": "string" },
    { "key": "orderId", "value": "1", "type": "string" },
    { "key": "reviewId", "value": "1", "type": "string" },
    { "key": "discountId", "value": "1", "type": "string" },
    { "key": "imageId", "value": "1", "type": "string" },
    { "key": "specId", "value": "1", "type": "string" }
  ],
  "item": [
    {
      "name": "🔐 Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"customer@example.com\",\n  \"password\": \"Password123!\",\n  \"firstName\": \"John\",\n  \"lastName\": \"Doe\",\n  \"phone\": \"9841234567\"\n}"
            }
          }
        },
        {
          "name": "Login (Customer)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data.token) {",
                  "  pm.collectionVariables.set('token', res.data.token);",
                  "  console.log('Customer token saved');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"customer@example.com\",\n  \"password\": \"Password123!\"\n}"
            }
          }
        },
        {
          "name": "Login (Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data.token) {",
                  "  pm.collectionVariables.set('adminToken', res.data.token);",
                  "  console.log('Admin token saved');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@dailydose.com\",\n  \"password\": \"Admin@123\"\n}"
            }
          }
        },
        {
          "name": "Get Current User",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/auth/me", "host": ["{{baseUrl}}"], "path": ["auth", "me"] }
          }
        },
        {
          "name": "Verify Email",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/verify-email", "host": ["{{baseUrl}}"], "path": ["auth", "verify-email"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"YOUR_VERIFICATION_TOKEN\"\n}"
            }
          }
        },
        {
          "name": "Resend Verification Email",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/resend-verification", "host": ["{{baseUrl}}"], "path": ["auth", "resend-verification"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"customer@example.com\"\n}"
            }
          }
        },
        {
          "name": "Forgot Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/forgot-password", "host": ["{{baseUrl}}"], "path": ["auth", "forgot-password"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"customer@example.com\"\n}"
            }
          }
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/reset-password", "host": ["{{baseUrl}}"], "path": ["auth", "reset-password"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"YOUR_RESET_TOKEN\",\n  \"password\": \"NewPassword123!\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "📦 Products",
      "item": [
        {
          "name": "Public",
          "item": [
            {
              "name": "Get All Products",
              "request": {
                "method": "GET",
                "url": {
                  "raw": "{{baseUrl}}/products?page=1&limit=12&sortBy=createdAt&sortOrder=desc",
                  "host": ["{{baseUrl}}"],
                  "path": ["products"],
                  "query": [
                    { "key": "page", "value": "1" },
                    { "key": "limit", "value": "12" },
                    { "key": "search", "value": "", "disabled": true },
                    { "key": "categoryId", "value": "", "disabled": true },
                    { "key": "categorySlug", "value": "", "disabled": true },
                    { "key": "brandId", "value": "", "disabled": true },
                    { "key": "brandSlug", "value": "", "disabled": true },
                    { "key": "minPrice", "value": "", "disabled": true },
                    { "key": "maxPrice", "value": "", "disabled": true },
                    { "key": "inStock", "value": "true", "disabled": true },
                    { "key": "isFeatured", "value": "true", "disabled": true },
                    { "key": "sortBy", "value": "createdAt" },
                    { "key": "sortOrder", "value": "desc" }
                  ]
                }
              }
            },
            {
              "name": "Get Discounted Products",
              "request": {
                "method": "GET",
                "url": {
                  "raw": "{{baseUrl}}/products/discounted?limit=10",
                  "host": ["{{baseUrl}}"],
                  "path": ["products", "discounted"],
                  "query": [{ "key": "limit", "value": "10" }]
                }
              }
            },
            {
              "name": "Get Product by Slug",
              "request": {
                "method": "GET",
                "url": {
                  "raw": "{{baseUrl}}/products/slug/{{productSlug}}",
                  "host": ["{{baseUrl}}"],
                  "path": ["products", "slug", "{{productSlug}}"]
