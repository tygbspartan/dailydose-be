              }
            },
            {
              "name": "Get Product Images",
              "request": {
                "method": "GET",
                "url": {
                  "raw": "{{baseUrl}}/products/{{productId}}/images",
                  "host": ["{{baseUrl}}"],
                  "path": ["products", "{{productId}}", "images"]
