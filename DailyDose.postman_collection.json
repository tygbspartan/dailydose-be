              "name": "Get Product Specifications",
              "request": {
                "method": "GET",
                "url": {
                  "raw": "{{baseUrl}}/products/{{productId}}/specifications",
                  "host": ["{{baseUrl}}"],
                  "path": ["products", "{{productId}}", "specifications"]
